<Window x:Class="CommunicationSystem.Desktop.MainWindow"
        x:Name="MainWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网上沟通交流系统" Height="720" Width="1080" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="💬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="网上沟通交流系统" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,4"
                            Command="{Binding RefreshAllCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="355"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                <DockPanel LastChildFill="True">
                    <!-- Search -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="搜索用户" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="留空搜索将显示推荐好友" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                        <Button Content="搜索并添加好友" Style="{StaticResource SecondaryButton}" Height="34"
                                Margin="0,8,0,0" Command="{Binding SearchUsersCommand}"/>
                        <ListBox ItemsSource="{Binding SearchResults}" Style="{StaticResource ModernListBox}"
                                 ItemContainerStyle="{StaticResource ModernListBoxItem}"
                                 MaxHeight="90" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="加好友" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.AddFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding Username}" Style="{StaticResource CaptionText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Friend Requests -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6">
                            <Run Text="好友申请"/>
                            <Run Text="{Binding PendingRequestCount, StringFormat= ({0})}"/>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding FriendRequests}" Style="{StaticResource ModernListBox}"
                                 ItemContainerStyle="{StaticResource ModernListBoxItem}" MaxHeight="88">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FromNickname}" FontSize="13" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="同意" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.AcceptFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="拒绝" Style="{StaticResource DangerSmallButton}"
                                                    Command="{Binding DataContext.RejectFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Friends -->
                    <TextBlock DockPanel.Dock="Top" Text="我的好友" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding Friends}" SelectedItem="{Binding SelectedFriend}"
                             Style="{StaticResource ModernListBox}" ItemContainerStyle="{StaticResource ModernListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="删除" Style="{StaticResource DangerSmallButton}"
                                            Command="{Binding DataContext.DeleteFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Border DockPanel.Dock="Right" MinWidth="20" Height="20" CornerRadius="10"
                                            Background="#EF4444" Margin="0,0,8,0" Padding="6,0"
                                            Visibility="{Binding UnreadCount, Converter={StaticResource UnreadBadgeVis}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UnreadCount, Converter={StaticResource UnreadCountText}}"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="36" Height="36" Fill="#DBEAFE"/>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" FontSize="13"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{Binding IsOnline, Converter={StaticResource OnlineColor}}"
                                                         Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding IsOnline, Converter={StaticResource OnlineText}}"
                                                           Style="{StaticResource CaptionText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Groups -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="群聊" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <Button Content="＋ 创建群聊" Style="{StaticResource PrimaryButton}" Height="38"
                                Margin="0,0,0,8" Command="{Binding OpenCreateGroupDialogCommand}"/>
                        <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                                 Style="{StaticResource ModernListBox}" ItemContainerStyle="{StaticResource ModernListBoxItem}"
                                 MaxHeight="130">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#EEF2FF">
                                            <TextBlock Text="群" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GroupName}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding MemberCount, StringFormat={}{0} 人}" Style="{StaticResource CaptionText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Chat Area -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="0" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat Header -->
                    <Border Grid.Row="0" Padding="20,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ChatTitle}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding TypingHint}" Style="{StaticResource CaptionText}"
                                           Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Visibility="{Binding IsGroupSelected, Converter={StaticResource BoolToVis}}">
                                <Button Content="成员" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,4"
                                        Margin="0,0,8,0" Command="{Binding ShowGroupMembersCommand}"/>
                                <Button Content="邀请" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,4"
                                        Margin="0,0,8,0" Command="{Binding OpenInviteGroupDialogCommand}"/>
                                <Button Content="退出" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,4"
                                        Margin="0,0,8,0" Command="{Binding LeaveGroupCommand}"
                                        Visibility="{Binding IsGroupMemberNotOwner, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="解散" Style="{StaticResource DangerSmallButton}" Height="32" Padding="12,4"
                                        Command="{Binding DissolveGroupCommand}"
                                        Visibility="{Binding IsGroupOwner, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Messages -->
                    <ScrollViewer x:Name="MessageScrollViewer"
                                    Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto"
                                    Background="#F8FAFC"
                                    IsDeferredScrollingEnabled="True">
                        <ItemsControl ItemsSource="{Binding Messages}" Margin="16,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MaxWidth="420" CornerRadius="16" Padding="14,10" Margin="0,6"
                                            BorderBrush="{StaticResource BorderBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Background" Value="#2563EB"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SenderNickname}" FontSize="11" Foreground="#64748B"
                                                       Margin="0,0,0,4" Visibility="{Binding ShowSender}"/>
                                            <TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap" FontSize="14"
                                                       Visibility="{Binding ShowText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#0F172A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding ImageSource}"
                                                   MaxWidth="260" MaxHeight="260" Stretch="Uniform"
                                                   Margin="0,2,0,2" Visibility="{Binding ShowImage}"/>
                                            <TextBlock FontSize="13" Visibility="{Binding ShowFile}">
                                                <Hyperlink NavigateUri="{Binding Content}" RequestNavigate="FileLink_RequestNavigate">
                                                    📎 点击打开文件
                                                </Hyperlink>
                                            </TextBlock>
                                            <DockPanel Margin="0,6,0,0">
                                                <Button DockPanel.Dock="Right" Content="撤回" Style="{StaticResource DangerSmallButton}"
                                                        Visibility="{Binding ShowRecall}"
                                                        Command="{Binding DataContext.RecallMessageCommand, ElementName=MainWin}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding TimeText}" FontSize="10" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                    <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Input Area -->
                    <Border Grid.Row="2" Background="White" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource PrimaryButton}"
                                        Width="80" Height="38" Margin="10,0,0,0"
                                        Command="{Binding SendMessageCommand}"/>
                                <Button DockPanel.Dock="Right" Content="📎 文件" Style="{StaticResource SecondaryButton}"
                                        Height="38" Command="{Binding SendFileCommand}"/>
                                <TextBox Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         KeyDown="Input_OnKeyDown"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="清空记录" Style="{StaticResource DangerSmallButton}" Height="30"
                                        Command="{Binding ClearHistoryCommand}"/>
                                <TextBox Width="180" Text="{Binding HistoryKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Margin="10,0,0,0"/>
                                <Button Content="搜索历史" Style="{StaticResource SecondaryButton}" Height="30"
                                        Padding="12,4" Margin="8,0,0,0"
                                        Command="{Binding LoadMessagesCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
