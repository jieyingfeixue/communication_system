@{
    ViewData["Title"] = "聊天";
    Layout = "_Layout";
    var apiBase = "http://localhost:5000";
    var token = Context.Session.GetString("Token");
    var nickname = Context.Session.GetString("Nickname");
    var userId = Context.Session.GetInt32("UserId") ?? 0;
}

<div class="row" style="height: calc(100vh - 120px);">
    <div class="col-md-3 border-end bg-white p-2 d-flex flex-column">
        <div class="mb-2">
            <input id="searchKeyword" class="form-control form-control-sm" placeholder="搜索用户加好友（留空显示推荐）" />
            <button class="btn btn-sm btn-outline-primary w-100 mt-1" onclick="searchUsers()">搜索</button>
            <div id="searchResults" class="small mt-1"></div>
        </div>
        <div class="mb-2">
            <button class="btn btn-sm btn-outline-secondary w-100 mt-1" onclick="refreshAll()">刷新列表</button>
        </div>
        <div class="mb-2">
            <button class="btn btn-sm btn-success w-100" onclick="showCreateGroup()">创建群聊</button>
        </div>
        <h6>好友申请 <span id="requestBadge" class="badge bg-danger d-none">0</span></h6>
        <div id="requestList" class="small mb-2"></div>
        <h6>好友</h6>
        <div id="friendList" class="flex-grow-1 overflow-auto"></div>
        <h6 class="mt-2">群聊</h6>
        <div id="groupList" class="overflow-auto" style="max-height:30%"></div>
    </div>
    <div class="col-md-9 d-flex flex-column bg-white">
        <div class="border-bottom p-2 d-flex justify-content-between align-items-center">
            <div>
                <strong id="chatTitle">请选择会话</strong>
                <span id="typingHint" class="text-muted small ms-2"></span>
                <span id="onlineHint" class="badge bg-secondary ms-2"></span>
            </div>
            <div id="groupToolbar" class="d-none gap-1">
                <button class="btn btn-sm btn-outline-secondary" onclick="showGroupMembers()">成员</button>
                <button class="btn btn-sm btn-outline-primary" onclick="showInviteGroup()">邀请</button>
                <button class="btn btn-sm btn-outline-warning" id="btnLeaveGroup" onclick="leaveGroup()">退出</button>
                <button class="btn btn-sm btn-outline-danger" id="btnDissolveGroup" onclick="dissolveGroup()">解散</button>
            </div>
        </div>
        <div id="messageBox" class="flex-grow-1 overflow-auto p-3" style="background:#f8f9fa;"></div>
        <div class="border-top p-2">
            <div class="input-group">
                <input type="file" id="fileInput" class="d-none" onchange="uploadFile()" />
                <button class="btn btn-outline-secondary" onclick="document.getElementById('fileInput').click()">文件</button>
                <input id="msgInput" class="form-control" placeholder="输入消息..." onkeydown="onMsgKey(event)" oninput="notifyTyping()" />
                <button class="btn btn-primary" onclick="sendText()">发送</button>
            </div>
            <div class="mt-1">
                <button class="btn btn-sm btn-outline-danger" onclick="clearHistory()">清空记录</button>
                <input id="historyKeyword" class="form-control form-control-sm d-inline-block w-auto" placeholder="搜索历史" />
                <button class="btn btn-sm btn-outline-secondary" onclick="searchHistory()">搜索</button>
            </div>
        </div>
    </div>
</div>

<!-- 创建群聊 -->
<div class="modal fade" id="createGroupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">创建群聊</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">群名称</label>
                <input id="newGroupName" class="form-control mb-3" placeholder="请输入群名称" />
                <label class="form-label">邀请好友（可多选）</label>
                <div id="createGroupFriends" class="border rounded p-2" style="max-height:200px;overflow:auto"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="submitCreateGroup()">创建</button>
            </div>
        </div>
    </div>
</div>

<!-- 邀请入群 -->
<div class="modal fade" id="inviteGroupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">邀请好友入群</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="inviteGroupFriends" class="border rounded p-2" style="max-height:240px;overflow:auto"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="submitInviteGroup()">邀请</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
<script>
const apiBase = '@apiBase';
const token = '@token';
const myNickname = '@nickname';
const myUserId = @userId;
let connection, currentFriendId = null, currentGroupId = null, currentGroupOwnerId = null, typingTimer;
let cachedGroups = [], cachedFriends = [], cachedGroupMembers = [];

connection = new signalR.HubConnectionBuilder()
    .withUrl(`${apiBase}/hubs/chat?access_token=${token}`)
    .withAutomaticReconnect()
    .build();

connection.on('ReceiveMessage', msg => {
    const inPrivate = currentFriendId && msg.groupId == null &&
        ((msg.senderId === currentFriendId && msg.receiverId === myUserId) ||
         (msg.senderId === myUserId && msg.receiverId === currentFriendId));
    const inGroup = currentGroupId && msg.groupId === currentGroupId;
    if (inPrivate || inGroup) {
        appendMessage(msg);
        if (inPrivate && msg.senderId === currentFriendId)
            connection.invoke('MarkAsRead', currentFriendId);
    }
    bumpFriendOnMessage(msg);
});
connection.on('UserTyping', n => {
    if ((currentFriendId && n.userId === currentFriendId) || (currentGroupId && n.groupId === currentGroupId))
        document.getElementById('typingHint').textContent = `${n.nickname} 正在输入...`;
    setTimeout(() => document.getElementById('typingHint').textContent = '', 2000);
});
connection.on('FriendRequestReceived', () => loadRequests());
connection.on('FriendListChanged', () => refreshAll());
connection.on('GroupListChanged', () => loadGroups());
connection.on('GroupDissolved', id => {
    if (currentGroupId === id) {
        currentGroupId = null; currentGroupOwnerId = null;
        document.getElementById('chatTitle').textContent = '请选择会话';
        document.getElementById('messageBox').innerHTML = '';
        document.getElementById('groupToolbar').classList.add('d-none');
        document.getElementById('groupToolbar').classList.remove('d-flex');
    }
    loadGroups();
});
connection.on('MessageDeleted', id => removeMessage(id));
connection.on('ChatHistoryCleared', (friendId, groupId) => {
    if ((currentFriendId && currentFriendId === friendId) || (currentGroupId && currentGroupId === groupId))
        loadMessages();
});
connection.on('UserOnline', id => refreshOnline(id, true));
connection.on('UserOffline', id => refreshOnline(id, false));
connection.onreconnected(() => refreshAll());
connection.start().catch(e => console.error(e));

async function api(url, opts = {}) {
    opts.headers = Object.assign({ 'Authorization': `Bearer ${token}` }, opts.headers || {});
    if (opts.body && typeof opts.body === 'object') {
        opts.headers['Content-Type'] = 'application/json';
        opts.body = JSON.stringify(opts.body);
    }
    const r = await fetch(url, opts);
    return r.json();
}

async function loadFriends() {
    cachedFriends = await fetch('/Chat/Friends').then(r => r.json());
    renderFriendList();
}

function renderFriendList() {
    const html = cachedFriends.map(f => {
        const unread = f.unreadCount || 0;
        const badge = unread > 0
            ? `<span class="badge bg-danger rounded-pill float-end me-4">${unread > 99 ? '99+' : unread}</span>` : '';
        const nameClass = unread > 0 ? 'fw-bold' : '';
        const safeName = f.nickname.replace(/'/g, "\\'").replace(/"/g, '&quot;');
        return `<div class="list-group-item list-group-item-action p-2 ${nameClass}" onclick="openChat(${f.userId}, null, '${safeName}', ${f.isOnline})">
            <span class="badge ${f.isOnline ? 'bg-success' : 'bg-secondary'} me-1">●</span>${f.nickname}${badge}
            <button class="btn btn-sm btn-link text-danger float-end p-0" onclick="event.stopPropagation();deleteFriend(${f.userId})">删</button>
        </div>`;
    }).join('');
    document.getElementById('friendList').innerHTML = html || '<div class="text-muted small">暂无好友</div>';
}

function bumpFriendOnMessage(msg) {
    if (msg.groupId != null) return;
    let friendId = null, incrementUnread = false;
    if (msg.receiverId === myUserId) {
        friendId = msg.senderId;
        incrementUnread = currentFriendId !== friendId;
    } else if (msg.senderId === myUserId && msg.receiverId) {
        friendId = msg.receiverId;
    }
    if (!friendId) return;
    const idx = cachedFriends.findIndex(x => x.userId === friendId);
    if (idx < 0) { loadFriends(); return; }
    const f = cachedFriends[idx];
    const unread = incrementUnread
        ? (f.unreadCount || 0) + 1
        : (currentFriendId === friendId ? 0 : (f.unreadCount || 0));
    const updated = { ...f, lastMessageTime: msg.createTime, unreadCount: unread };
    cachedFriends.splice(idx, 1);
    cachedFriends.unshift(updated);
    renderFriendList();
}

async function loadGroups() {
    const groups = await fetch('/Chat/Groups').then(r => r.json());
    cachedGroups = groups;
    document.getElementById('groupList').innerHTML = groups.map(g =>
        `<div class="list-group-item list-group-item-action p-2" onclick="openChat(null, ${g.id}, '${g.groupName}', true, ${g.ownerId})">
            ${g.groupName} <small class="text-muted">(${g.memberCount}人)</small>
        </div>`
    ).join('') || '<div class="text-muted small">暂无群聊</div>';
}

async function loadRequests() {
    const reqs = await fetch('/Chat/Requests').then(r => r.json());
    const badge = document.getElementById('requestBadge');
    const list = document.getElementById('requestList');
    if (reqs.length) {
        badge.classList.remove('d-none');
        badge.textContent = reqs.length;
        list.innerHTML = reqs.map(r => `
            <div class="alert alert-warning p-2 small mb-1">
                ${r.fromNickname} 请求加好友
                <button class="btn btn-sm btn-success" onclick="acceptFriend(${r.friendshipId})">同意</button>
                <button class="btn btn-sm btn-secondary" onclick="rejectFriend(${r.friendshipId})">拒绝</button>
            </div>`).join('');
    } else {
        badge.classList.add('d-none');
        list.innerHTML = '';
    }
}

async function refreshAll() {
    await loadFriends();
    await loadGroups();
    await loadRequests();
}

async function searchUsers() {
    const kw = document.getElementById('searchKeyword').value.trim();
    const url = kw ? `/Chat/SearchUsers?keyword=${encodeURIComponent(kw)}` : '/Chat/SearchUsers';
    const users = await fetch(url).then(r => r.json());
    const title = kw ? '' : '<div class="text-muted small mb-1">推荐好友</div>';
    document.getElementById('searchResults').innerHTML = title + (users.map(u =>
        `<div class="d-flex justify-content-between align-items-center border-bottom py-1">
            <span>${u.nickname} (${u.username})</span>
            <button class="btn btn-sm btn-primary" onclick="addFriend(${u.id})">加好友</button>
        </div>`).join('') || '<div class="text-muted">暂无可推荐用户</div>');
}

async function addFriend(id) {
    const r = await fetch('/Chat/AddFriend', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({targetUserId:id})}).then(r=>r.json());
    alert(r.message || (r.success ? '好友申请已发送' : '操作失败'));
}

async function acceptFriend(id) { await fetch('/Chat/AcceptFriend', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({friendshipId:id})}); await refreshAll(); }
async function rejectFriend(id) { await fetch('/Chat/RejectFriend', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({friendshipId:id})}); await loadRequests(); }
async function deleteFriend(id) { if(confirm('确认删除好友？')) { await fetch(`/Chat/DeleteFriend?friendId=${id}`, {method:'DELETE'}); loadFriends(); } }

function showCreateGroup() {
    if (!cachedFriends.length) { alert('请先添加好友后再创建群聊'); return; }
    document.getElementById('newGroupName').value = '';
    document.getElementById('createGroupFriends').innerHTML = cachedFriends.map(f =>
        `<label class="d-flex align-items-center gap-2 py-1 border-bottom">
            <input type="checkbox" class="create-member-cb" value="${f.userId}" />
            <span>${f.nickname}</span>
        </label>`).join('');
    new bootstrap.Modal(document.getElementById('createGroupModal')).show();
}

async function submitCreateGroup() {
    const name = document.getElementById('newGroupName').value.trim();
    if (!name) { alert('请输入群名称'); return; }
    const memberUserIds = [...document.querySelectorAll('.create-member-cb:checked')].map(cb => parseInt(cb.value));
    const r = await fetch('/Chat/CreateGroup', { method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ groupName: name, memberUserIds }) }).then(r => r.json());
    alert(r.message || (r.success ? '创建成功' : '创建失败'));
    if (r.success) { bootstrap.Modal.getInstance(document.getElementById('createGroupModal')).hide(); loadGroups(); }
}

async function openChat(friendId, groupId, title, online, ownerId) {
    currentFriendId = friendId; currentGroupId = groupId; currentGroupOwnerId = ownerId ?? null;
    document.getElementById('chatTitle').textContent = title;
    document.getElementById('onlineHint').textContent = friendId ? (online ? '在线' : '离线') : '群聊';
    document.getElementById('onlineHint').className = `badge ms-2 ${online ? 'bg-success' : 'bg-secondary'}`;
    const toolbar = document.getElementById('groupToolbar');
    if (groupId) {
        toolbar.classList.remove('d-none');
        toolbar.classList.add('d-flex');
        const isOwner = ownerId === myUserId;
        document.getElementById('btnLeaveGroup').style.display = isOwner ? 'none' : '';
        document.getElementById('btnDissolveGroup').style.display = isOwner ? '' : 'none';
        cachedGroupMembers = await fetch(`/Chat/GroupMembers?groupId=${groupId}`).then(r => r.json());
    } else {
        toolbar.classList.add('d-none');
        toolbar.classList.remove('d-flex');
    }
    await loadMessages();
    if (friendId) {
        connection.invoke('MarkAsRead', friendId);
        const f = cachedFriends.find(x => x.userId === friendId);
        if (f) {
            f.unreadCount = 0;
            renderFriendList();
        }
    }
}

async function showGroupMembers() {
    if (!currentGroupId) return;
    const members = await fetch(`/Chat/GroupMembers?groupId=${currentGroupId}`).then(r => r.json());
    cachedGroupMembers = members;
    alert('群成员：\n' + members.map(m => m.nickname).join('\n') || '暂无成员');
}

function showInviteGroup() {
    const inGroup = new Set(cachedGroupMembers.map(m => m.userId));
    const candidates = cachedFriends.filter(f => !inGroup.has(f.userId));
    if (!candidates.length) { alert('没有可邀请的好友'); return; }
    document.getElementById('inviteGroupFriends').innerHTML = candidates.map(f =>
        `<label class="d-flex align-items-center gap-2 py-1 border-bottom">
            <input type="checkbox" class="invite-member-cb" value="${f.userId}" />
            <span>${f.nickname}</span>
        </label>`).join('');
    new bootstrap.Modal(document.getElementById('inviteGroupModal')).show();
}

async function submitInviteGroup() {
    const userIds = [...document.querySelectorAll('.invite-member-cb:checked')].map(cb => parseInt(cb.value));
    if (!userIds.length) { alert('请选择好友'); return; }
    const r = await fetch('/Chat/InviteToGroup', { method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ groupId: currentGroupId, userIds }) }).then(r => r.json());
    alert(r.message || (r.success ? '邀请成功' : '邀请失败'));
    if (r.success) {
        bootstrap.Modal.getInstance(document.getElementById('inviteGroupModal')).hide();
        cachedGroupMembers = await fetch(`/Chat/GroupMembers?groupId=${currentGroupId}`).then(r => r.json());
        loadGroups();
    }
}

async function leaveGroup() {
    if (!currentGroupId || !confirm('确定退出该群聊？')) return;
    const r = await fetch('/Chat/LeaveGroup', { method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ groupId: currentGroupId, userId: 0 }) }).then(r => r.json());
    alert(r.message || (r.success ? '已退出' : '操作失败'));
    if (r.success) {
        currentGroupId = null; currentGroupOwnerId = null;
        document.getElementById('chatTitle').textContent = '请选择会话';
        document.getElementById('messageBox').innerHTML = '';
        document.getElementById('groupToolbar').classList.add('d-none');
        document.getElementById('groupToolbar').classList.remove('d-flex');
        loadGroups();
    }
}

async function dissolveGroup() {
    if (!currentGroupId || !confirm('确定解散该群聊？所有成员将无法继续群聊。')) return;
    const r = await fetch(`/Chat/DissolveGroup?groupId=${currentGroupId}`, { method:'DELETE' }).then(r => r.json());
    alert(r.message || (r.success ? '已解散' : '操作失败'));
    if (r.success) {
        currentGroupId = null; currentGroupOwnerId = null;
        document.getElementById('chatTitle').textContent = '请选择会话';
        document.getElementById('messageBox').innerHTML = '';
        document.getElementById('groupToolbar').classList.add('d-none');
        loadGroups();
    }
}

async function loadMessages(keyword) {
    let url = '/Chat/Messages?';
    if (currentFriendId) url += `friendId=${currentFriendId}`;
    if (currentGroupId) url += `groupId=${currentGroupId}`;
    if (keyword) url += `&keyword=${encodeURIComponent(keyword)}`;
    const msgs = await fetch(url).then(r => r.json());
    document.getElementById('messageBox').innerHTML = '';
    msgs.forEach(appendMessage);
    const box = document.getElementById('messageBox');
    box.scrollTop = box.scrollHeight;
}

function parseMessageTime(iso) {
    if (!iso) return new Date(NaN);
    if (typeof iso === 'string' && !iso.endsWith('Z') && !/[+-]\d{2}:\d{2}$/.test(iso))
        return new Date(iso + 'Z');
    return new Date(iso);
}

function canRecallMessage(msg) {
    if (currentGroupId && currentGroupOwnerId === myUserId) return true;
    if (msg.senderId !== myUserId) return false;
    return (Date.now() - parseMessageTime(msg.createTime).getTime()) / 60000 <= 2;
}

function appendMessage(msg) {
    const box = document.getElementById('messageBox');
    const isMe = msg.senderId === myUserId;
    let content = msg.content;
    if (msg.messageType === 1) content = `<img src="${msg.content}" style="max-width:200px" />`;
    if (msg.messageType === 2) content = `<a href="${msg.content}" target="_blank">📎 文件</a>`;
    const recallBtn = canRecallMessage(msg)
        ? `<button class="btn btn-sm btn-link" onclick="recallMsg(${msg.id})">撤回</button>` : '';
    const div = document.createElement('div');
    div.dataset.msgId = msg.id;
    div.className = `mb-2 ${isMe ? 'text-end' : ''}`;
    div.innerHTML = `<small class="text-muted">${msg.senderNickname} ${parseMessageTime(msg.createTime).toLocaleString()}</small>
        <div class="d-inline-block p-2 rounded ${isMe ? 'bg-primary text-white' : 'bg-white border'}">${content}</div>
        ${recallBtn}`;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
}

function removeMessage(id) {
    const el = document.querySelector(`[data-msg-id="${id}"]`);
    if (el) el.remove();
}

async function sendText() {
    const text = document.getElementById('msgInput').value.trim();
    if (!text || (!currentFriendId && !currentGroupId)) return;
    await connection.invoke('SendMessage', { receiverId: currentFriendId, groupId: currentGroupId, content: text, messageType: 0 });
    document.getElementById('msgInput').value = '';
}

function onMsgKey(e) { if (e.key === 'Enter') sendText(); }
function notifyTyping() {
    clearTimeout(typingTimer);
    connection.invoke('NotifyTyping', currentFriendId, currentGroupId);
    typingTimer = setTimeout(() => {}, 1000);
}

async function uploadFile() {
    const file = document.getElementById('fileInput').files[0];
    if (!file) return;
    const fd = new FormData(); fd.append('file', file);
    const r = await fetch(`${apiBase}/api/files/upload`, { method:'POST', headers:{Authorization:`Bearer ${token}`}, body: fd }).then(r=>r.json());
    const type = file.type.startsWith('image/') ? 1 : 2;
    await connection.invoke('SendMessage', { receiverId: currentFriendId, groupId: currentGroupId, content: r.url, messageType: type });
}

async function recallMsg(id) {
    const r = await fetch(`/Chat/RecallMessage?id=${id}`, { method:'POST' }).then(r => r.json());
    if (!r.success) alert(r.message || '撤回失败');
}

async function clearHistory() {
    if (!confirm('确认清空？')) return;
    let url = '/Chat/ClearHistory?';
    if (currentFriendId) url += `friendId=${currentFriendId}`;
    if (currentGroupId) url += `groupId=${currentGroupId}`;
    await fetch(url, {method:'DELETE'}); loadMessages();
}
function searchHistory() { loadMessages(document.getElementById('historyKeyword').value); }
function refreshOnline(id, online) {
    if (currentFriendId === id) {
        document.getElementById('onlineHint').textContent = online ? '在线' : '离线';
        document.getElementById('onlineHint').className = `badge ms-2 ${online ? 'bg-success' : 'bg-secondary'}`;
    }
    cachedFriends = cachedFriends.map(f => f.userId === id ? { ...f, isOnline: online } : f);
    renderFriendList();
}

loadFriends(); loadGroups(); loadRequests();</script>
}
