<Window x:Class="CommunicationSystem.Desktop.Views.CreateGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建群聊" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource CardBorder}" Margin="20">
        <StackPanel>
            <TextBlock Text="创建群聊" Style="{StaticResource TitleText}" FontSize="18" Margin="0,0,0,16"/>
            <TextBlock Text="群名称" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBox}" MinHeight="42" Margin="0,0,0,16"/>
            <TextBlock Text="邀请好友（可多选）" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Friends}" Style="{StaticResource ModernListBox}"
                     ItemContainerStyle="{StaticResource ModernListBoxItem}" MaxHeight="220">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Friend.Nickname}" FontSize="13"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}"
                       Margin="0,10,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="创建" Style="{StaticResource PrimaryButton}" Width="90"
                        Command="{Binding CreateCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
