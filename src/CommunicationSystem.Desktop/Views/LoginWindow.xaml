<Window x:Class="CommunicationSystem.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网上沟通交流系统" Height="603" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2563EB" Offset="0"/>
                    <GradientStop Color="#6366F1" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="💬" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="网上沟通交流系统" FontSize="20" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Modern Chat · SignalR 实时通信" FontSize="12"
                           Foreground="#E0E7FF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="24,-28,24,24" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="欢迎回来" Style="{StaticResource TitleText}" FontSize="18" Margin="0,0,0,4"
                           Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisInverse}}"/>
                <TextBlock Text="创建账号" Style="{StaticResource TitleText}" FontSize="18" Margin="0,0,0,4"
                           Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="登录后即可与好友实时聊天" Style="{StaticResource CaptionText}" Margin="0,0,0,16"
                           Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisInverse}}"/>

                <TextBlock Text="用户名" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="密码" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PwdBox" Style="{StaticResource ModernPasswordBox}"
                             Margin="0,0,0,12" PasswordChanged="PwdBox_OnPasswordChanged"/>

                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="昵称" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" FontSize="12" MinHeight="18" Margin="0,0,0,12"/>

                <Button Content="登 录" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                        Command="{Binding LoginCommand}"
                        Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisInverse}}"/>
                <Button Content="提交注册" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                        Command="{Binding RegisterCommand}"
                        Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>

                <Button Content="没有账号？立即注册" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleModeCommand}" Margin="0,4,0,0"
                        Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisInverse}}"/>
                <Button Content="已有账号？返回登录" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleModeCommand}" Margin="0,4,0,0"
                        Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
